{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Cloud Mail encrypted backup manifest v1",
  "$comment": "Structural interchange schema. manifest.mjs additionally enforces chronological bounds, contiguous migration names, unique object identities, blob consistency and ciphertext size >= plaintext size. Verification also requires decrypt/hash/reference/trusted-DDL checks.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "encryption", "snapshotId", "snapshotAt", "createdAt", "appCommit", "appSourceSha256", "schema", "database", "objects", "deletionLedgerThrough"],
  "properties": {
    "version": {"const": 1},
    "encryption": {"const": "age-v1"},
    "snapshotId": {"$ref": "#/$defs/uuid"},
    "snapshotAt": {"$ref": "#/$defs/integer"},
    "createdAt": {"type": "integer", "minimum": 0, "maximum": 8640000000000000},
    "appCommit": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
    "appSourceSha256": {"$ref": "#/$defs/hash"},
    "deletionLedgerThrough": {"$ref": "#/$defs/integer"},
    "schema": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["version", "checksum"],
        "properties": {"version": {"type": "string", "pattern": "^[0-9]{4}_[a-z0-9_]+\\.sql$"}, "checksum": {"$ref": "#/$defs/hash"}}
      }
    },
    "database": {
      "type": "object", "additionalProperties": false, "required": ["bookmark", "blob"],
      "properties": {"bookmark": {"type": "string", "minLength": 1, "maxLength": 1024}, "blob": {"$ref": "#/$defs/blob"}}
    },
    "objects": {"type": "array", "items": {"$ref": "#/$defs/object"}}
  },
  "$defs": {
    "integer": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
    "uuid": {"type": "string", "pattern": "^[a-f0-9]{8}-[a-f0-9]{4}-4[a-f0-9]{3}-[89ab][a-f0-9]{3}-[a-f0-9]{12}$"},
    "hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "checksum": {
      "type": "object", "additionalProperties": false, "required": ["size", "sha256"],
      "properties": {"size": {"$ref": "#/$defs/integer"}, "sha256": {"$ref": "#/$defs/hash"}}
    },
    "blob": {
      "type": "object", "additionalProperties": false, "required": ["file", "plain", "cipher"],
      "properties": {
        "file": {"type": "string", "pattern": "^[a-f0-9]{8}-[a-f0-9]{4}-4[a-f0-9]{3}-[89ab][a-f0-9]{3}-[a-f0-9]{12}\\.age$"},
        "plain": {"$ref": "#/$defs/checksum"}, "cipher": {"$ref": "#/$defs/checksum"}
      }
    },
    "metadata": {"type": "object", "propertyNames": {"maxLength": 1024}, "additionalProperties": {"type": "string", "maxLength": 16384}},
    "object": {
      "type": "object", "additionalProperties": false,
      "allOf": [{
        "if": {"properties": {"backend": {"const": "kv"}}, "required": ["backend"]},
        "then": {"properties": {"httpMetadata": {"maxProperties": 0}}}
      }],
      "required": ["backend", "key", "uploadedAt", "customMetadata", "httpMetadata", "blob"],
      "properties": {
        "backend": {"enum": ["r2", "kv", "s3"]},
        "key": {"type": "string", "minLength": 1, "maxLength": 1024, "pattern": "^[^\\u0000-\\u001f]+$"},
        "uploadedAt": {"$ref": "#/$defs/integer"},
        "customMetadata": {"$ref": "#/$defs/metadata"}, "httpMetadata": {"$ref": "#/$defs/metadata"}, "blob": {"$ref": "#/$defs/blob"}
      }
    }
  }
}
