# Copy to an ignored runtime.env and chmod 600; no values below are secrets.
APP_ORIGIN=https://mail.example.com
VPS_INGRESS_HOST=SET_DEDICATED_BACKEND_HOST
VPS_PORT=18766
# Keep loopback for isolated checks. Caddy integration uses the verified private
# bridge address a verified private bridge address only after its narrowly scoped firewall rule is ready.
VPS_BIND_ADDRESS=127.0.0.1
VPS_MAX_ACTIVE=8
VPS_PROXY_TOKEN=SET_64_LOWERCASE_HEX_RANDOM_TOKEN
MAIL_CLOUDFLARE_ACCOUNT=SET_CLOUDFLARE_ACCOUNT_ID
MAIL_D1_ID=SET_D1_DATABASE_ID
MAIL_KV_ID=SET_KV_NAMESPACE_ID
MAIL_R2_BUCKET=private-mail-storage
MAIL_QUEUE_NAME=mail-process
MAIL_QUEUE_ID=SET_MAIN_QUEUE_ID
MAIL_DLQ_NAME=mail-dead-letter
MAIL_DLQ_ID=SET_DLQ_ID
MAIL_DOMAINS=example.com
MAIL_ADMIN_EMAIL=you@example.com
# Independent mailbox password, not the password of Google or Cloudflare.
MAIL_AUTH_MODE=either
# Access OTP protects ONLY mail.example.com/api/login/access/callback.
# Missing Access settings hide OTP login; mailbox password remains available.
ACCESS_TEAM_DOMAIN=YOUR_TEAM.cloudflareaccess.com
ACCESS_AUD=SET_ACCESS_AUDIENCE
BACKUP_ACCESS_AUD=
BACKUP_ACCESS_CLIENT_ID=
CLOUDFLARE_API_TOKEN=SET_DEDICATED_ACCOUNT_TOKEN_D1_KV_QUEUES
R2_ACCESS_KEY_ID=SET_BUCKET_SCOPED_S3_KEY
R2_SECRET_ACCESS_KEY=SET_BUCKET_SCOPED_S3_SECRET
VPS_QUEUE_ENABLED=false
# Optional independent notification secret, provisioned to the inbound Worker too.
# VPS_WAKE_TOKEN=<64 lowercase hex characters; never reuse VPS_PROXY_TOKEN>
VPS_MAINTENANCE_ENABLED=false
MAIL_RECOVERY_ENABLED=false
MAIL_DELETION_ENABLED=false
MAIL_TRASH_EXPIRY_ENABLED=false
MAIL_PURGE_ENABLED=false
MAIL_GENERATION_GC_ENABLED=false

# Optional historical attachments. Leave empty for a fresh mailbox. Never infer
# the old store or reuse the new R2 credentials for an unrelated S3 provider.
LEGACY_MAIL_STORAGE=
# Controlled rollback of published legacy copies; source bytes must still match.
# This does not change storage versions, cursors, objects, or tombstones.
LEGACY_BACKFILL_READ_MODE=copy
LEGACY_S3_ENDPOINT=
LEGACY_S3_BUCKET=
LEGACY_S3_REGION=
LEGACY_S3_ACCESS_KEY_ID=
LEGACY_S3_SECRET_ACCESS_KEY=
# Optional when a legacy S3 provider is configured; omit for current true default.
# LEGACY_S3_FORCE_PATH_STYLE=false
